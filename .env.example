# Copia este archivo como ".env" y llena los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Token del bot (te lo da @BotFather)
BOT_TOKEN=

# ID del grupo VIP autorizado (los supergrupos empiezan con -100)
ALLOWED_GROUP_ID=

# true = muestra en consola el Chat ID de cada mensaje (útil para obtener el ID de un grupo nuevo)
LOG_UPDATES=false
