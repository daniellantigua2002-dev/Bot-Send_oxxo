# Copia este archivo como ".env" y llena los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Token del bot (te lo da @BotFather)
BOT_TOKEN=

# ID del grupo VIP autorizado (los supergrupos empiezan con -100)
ALLOWED_GROUP_ID=

# Links de pago como JSON en UNA sola línea: {"490":"https://pay.ecart.com/...","590":"https://..."}
# En LOCAL puedes dejar esto vacío y usar el archivo data/paymentLinks.json.
# En el SERVIDOR (Render) define esta variable: así los links no se suben a GitHub.
# Si está puesta, tiene prioridad sobre el archivo.
PAYMENT_LINKS=

# true = muestra en consola el Chat ID de cada mensaje (útil para obtener el ID de un grupo nuevo)
LOG_UPDATES=false

# false = muestra la ventana de Chromium mientras genera el OXXO (solo para depurar)
HEADLESS=true
